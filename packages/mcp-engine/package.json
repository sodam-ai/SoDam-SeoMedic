    "commander": "^15.0.0",
    "fast-xml-parser": "^5.9.3",
    "lighthouse": "^13.4.0",
    "linkedom": "^0.18.12",
    "playwright": "^1.61.1",
    "robots-parser": "^3.0.1",
    "tree-kill": "^1.2.2",
    "ts-morph": "^28.0.0",
    "undici": "^8.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
