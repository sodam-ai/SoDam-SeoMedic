{
  "name": "@seomedic/mcp",
  "version": "0.1.0",
  "description": "SeoMedic 진단 엔진 — 크롤+렌더+CWV+회귀감지 (Phase 1, 분석 전용)",
  "type": "module",
  "bin": {
    "seomedic": "dist/cli.js"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
